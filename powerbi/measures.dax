// DAX measures - Denial Prevention Simulator
// Generated by src/build_bi_assets.py from dashboard/dashboard_config.json.
// Paste into Power BI Desktop, or open powerbi/model.bim in Tabular Editor.

// Claims from the headline query extract.
Claims =
    SELECTEDVALUE ( 'headline'[claims] )
// format: #,0

// Denial rate from the headline query extract.
Denial rate =
    SELECTEDVALUE ( 'headline'[denial_pct] )
// format: 0.00"%"

// Denied amount from the headline query extract.
Denied amount =
    SELECTEDVALUE ( 'headline'[denied_amt] )
// format: \$#,0

// Traceable to a pre-submission control
Preventable share of denials =
    SELECTEDVALUE ( 'headline'[preventable_pct] )
// format: 0.00"%"

// At 100% control effectiveness — not a forecast
Modelled prevention opportunity =
    SELECTEDVALUE ( 'headline'[opportunity] )
// format: \$#,0

// Recovered on resubmission from the headline query extract.
Recovered on resubmission =
    SELECTEDVALUE ( 'headline'[recovered] )
// format: \$#,0

// Stopped before they become denials
Claims in pre-submission queue =
    SELECTEDVALUE ( 'queue_head'[queued] )
// format: #,0

// Amount at risk in queue from the queue_head query extract.
Amount at risk in queue =
    SELECTEDVALUE ( 'queue_head'[at_risk] )
// format: \$#,0

// Denied amount for the 'Denied dollars by category' visual.
Denied amount (by_category) =
    SUM ( 'by_category'[denied_amt] )
// format: #,0.00

// Claims where control failed for the 'Which control failed, and what happened when it did' visual.
Claims where control failed (controls) =
    SUM ( 'controls'[gaps] )
// format: #,0.00

// Denial rate when failed % for the 'Which control failed, and what happened when it did' visual.
Denial rate when failed % (controls) =
    AVERAGE ( 'controls'[denial_pct_when_failed] )
// format: #,0.00

// Denied amount for the 'Denial rate by service line' visual.
Denied amount (by_service) =
    SUM ( 'by_service'[denied_amt] )
// format: #,0.00

// Denial rate % for the 'Denial rate by service line' visual.
Denial rate % (by_service) =
    AVERAGE ( 'by_service'[denial_pct] )
// format: #,0.00

// Denial rate % for the 'Does the risk score separate anything?' visual.
Denial rate % (risk_band) =
    AVERAGE ( 'risk_band'[denial_pct] )
// format: #,0.00

// Denial rate % for the 'Submission lag and denial rate' visual.
Denial rate % (submit_lag) =
    AVERAGE ( 'submit_lag'[denial_pct] )
// format: #,0.00

// Claims for the 'Monthly trend' visual.
Claims (monthly) =
    SUM ( 'monthly'[claims] )
// format: #,0.00

// Denial rate % for the 'Monthly trend' visual.
Denial rate % (monthly) =
    AVERAGE ( 'monthly'[denial_pct] )
// format: #,0.00

// Denied for the 'Recovery on resubmission' visual.
Denied (resub) =
    SUM ( 'resub'[denied_amt] )
// format: #,0.00

// Recovered for the 'Recovery on resubmission' visual.
Recovered (resub) =
    SUM ( 'resub'[recovered] )
// format: #,0.00

// Amount at risk for the 'Pre-submission queue by owner' visual.
Amount at risk (queue_owner) =
    SUM ( 'queue_owner'[at_risk] )
// format: #,0.00

// Claims for the 'Pre-submission queue by owner' visual.
Claims (queue_owner) =
    SUM ( 'queue_owner'[claims] )
// format: #,0.00

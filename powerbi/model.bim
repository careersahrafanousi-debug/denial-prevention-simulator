{
  "name": "denial-prevention-simulator",
  "compatibilityLevel": 1567,
  "model": {
    "culture": "en-US",
    "dataAccessOptions": {
      "legacyRedirects": true,
      "returnErrorValuesAsNull": true
    },
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "sourceQueryCulture": "en-US",
    "tables": [
      {
        "name": "headline",
        "columns": [
          {
            "name": "claims",
            "dataType": "int64",
            "sourceColumn": "claims",
            "summarizeBy": "sum"
          },
          {
            "name": "billed",
            "dataType": "double",
            "sourceColumn": "billed",
            "summarizeBy": "sum"
          },
          {
            "name": "denial_pct",
            "dataType": "double",
            "sourceColumn": "denial_pct",
            "summarizeBy": "sum"
          },
          {
            "name": "denied_amt",
            "dataType": "double",
            "sourceColumn": "denied_amt",
            "summarizeBy": "sum"
          },
          {
            "name": "preventable_pct",
            "dataType": "double",
            "sourceColumn": "preventable_pct",
            "summarizeBy": "sum"
          },
          {
            "name": "opportunity",
            "dataType": "double",
            "sourceColumn": "opportunity",
            "summarizeBy": "sum"
          },
          {
            "name": "recovered",
            "dataType": "double",
            "sourceColumn": "recovered",
            "summarizeBy": "sum"
          },
          {
            "name": "dq_score",
            "dataType": "double",
            "sourceColumn": "dq_score",
            "summarizeBy": "sum"
          }
        ],
        "partitions": [
          {
            "name": "headline",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "Csv.Document(File.Contents(ExtractFolder & \"\\headline.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv])"
            }
          }
        ],
        "measures": [
          {
            "name": "Claims",
            "expression": "SELECTEDVALUE ( 'headline'[claims] )",
            "formatString": "#,0",
            "description": "Claims from the headline query extract."
          },
          {
            "name": "Denial rate",
            "expression": "SELECTEDVALUE ( 'headline'[denial_pct] )",
            "formatString": "0.00\"%\"",
            "description": "Denial rate from the headline query extract."
          },
          {
            "name": "Denied amount",
            "expression": "SELECTEDVALUE ( 'headline'[denied_amt] )",
            "formatString": "\\$#,0",
            "description": "Denied amount from the headline query extract."
          },
          {
            "name": "Preventable share of denials",
            "expression": "SELECTEDVALUE ( 'headline'[preventable_pct] )",
            "formatString": "0.00\"%\"",
            "description": "Traceable to a pre-submission control"
          },
          {
            "name": "Modelled prevention opportunity",
            "expression": "SELECTEDVALUE ( 'headline'[opportunity] )",
            "formatString": "\\$#,0",
            "description": "At 100% control effectiveness \u2014 not a forecast"
          },
          {
            "name": "Recovered on resubmission",
            "expression": "SELECTEDVALUE ( 'headline'[recovered] )",
            "formatString": "\\$#,0",
            "description": "Recovered on resubmission from the headline query extract."
          }
        ]
      },
      {
        "name": "queue_head",
        "columns": [
          {
            "name": "queued",
            "dataType": "int64",
            "sourceColumn": "queued",
            "summarizeBy": "sum"
          },
          {
            "name": "at_risk",
            "dataType": "double",
            "sourceColumn": "at_risk",
            "summarizeBy": "sum"
          },
          {
            "name": "high_risk",
            "dataType": "int64",
            "sourceColumn": "high_risk",
            "summarizeBy": "sum"
          }
        ],
        "partitions": [
          {
            "name": "queue_head",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "Csv.Document(File.Contents(ExtractFolder & \"\\queue_head.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv])"
            }
          }
        ],
        "measures": [
          {
            "name": "Claims in pre-submission queue",
            "expression": "SELECTEDVALUE ( 'queue_head'[queued] )",
            "formatString": "#,0",
            "description": "Stopped before they become denials"
          },
          {
            "name": "Amount at risk in queue",
            "expression": "SELECTEDVALUE ( 'queue_head'[at_risk] )",
            "formatString": "\\$#,0",
            "description": "Amount at risk in queue from the queue_head query extract."
          }
        ]
      },
      {
        "name": "by_reason",
        "columns": [
          {
            "name": "Reason_Description",
            "dataType": "string",
            "sourceColumn": "Reason_Description",
            "summarizeBy": "none"
          },
          {
            "name": "Reason_Category",
            "dataType": "string",
            "sourceColumn": "Reason_Category",
            "summarizeBy": "none"
          },
          {
            "name": "Preventable",
            "dataType": "string",
            "sourceColumn": "Preventable",
            "summarizeBy": "none"
          },
          {
            "name": "denials",
            "dataType": "int64",
            "sourceColumn": "denials",
            "summarizeBy": "sum"
          },
          {
            "name": "denied_amt",
            "dataType": "double",
            "sourceColumn": "denied_amt",
            "summarizeBy": "sum"
          },
          {
            "name": "opportunity",
            "dataType": "double",
            "sourceColumn": "opportunity",
            "summarizeBy": "sum"
          }
        ],
        "partitions": [
          {
            "name": "by_reason",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "Csv.Document(File.Contents(ExtractFolder & \"\\by_reason.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv])"
            }
          }
        ]
      },
      {
        "name": "by_category",
        "columns": [
          {
            "name": "Reason_Category",
            "dataType": "string",
            "sourceColumn": "Reason_Category",
            "summarizeBy": "none"
          },
          {
            "name": "denied_amt",
            "dataType": "double",
            "sourceColumn": "denied_amt",
            "summarizeBy": "sum"
          },
          {
            "name": "denials",
            "dataType": "int64",
            "sourceColumn": "denials",
            "summarizeBy": "sum"
          }
        ],
        "partitions": [
          {
            "name": "by_category",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "Csv.Document(File.Contents(ExtractFolder & \"\\by_category.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv])"
            }
          }
        ],
        "measures": [
          {
            "name": "Denied amount (by_category)",
            "expression": "SUM ( 'by_category'[denied_amt] )",
            "formatString": "#,0.00",
            "description": "Denied amount for the 'Denied dollars by category' visual."
          }
        ]
      },
      {
        "name": "by_payer",
        "columns": [
          {
            "name": "Payer_Name",
            "dataType": "string",
            "sourceColumn": "Payer_Name",
            "summarizeBy": "none"
          },
          {
            "name": "Payer_Type",
            "dataType": "string",
            "sourceColumn": "Payer_Type",
            "summarizeBy": "none"
          },
          {
            "name": "claims",
            "dataType": "int64",
            "sourceColumn": "claims",
            "summarizeBy": "sum"
          },
          {
            "name": "denial_pct",
            "dataType": "double",
            "sourceColumn": "denial_pct",
            "summarizeBy": "sum"
          },
          {
            "name": "denied_amt",
            "dataType": "double",
            "sourceColumn": "denied_amt",
            "summarizeBy": "sum"
          },
          {
            "name": "days_outstanding",
            "dataType": "double",
            "sourceColumn": "days_outstanding",
            "summarizeBy": "sum"
          }
        ],
        "partitions": [
          {
            "name": "by_payer",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "Csv.Document(File.Contents(ExtractFolder & \"\\by_payer.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv])"
            }
          }
        ]
      },
      {
        "name": "by_service",
        "columns": [
          {
            "name": "Service_Line",
            "dataType": "string",
            "sourceColumn": "Service_Line",
            "summarizeBy": "none"
          },
          {
            "name": "claims",
            "dataType": "int64",
            "sourceColumn": "claims",
            "summarizeBy": "sum"
          },
          {
            "name": "denial_pct",
            "dataType": "double",
            "sourceColumn": "denial_pct",
            "summarizeBy": "sum"
          },
          {
            "name": "denied_amt",
            "dataType": "double",
            "sourceColumn": "denied_amt",
            "summarizeBy": "sum"
          },
          {
            "name": "opportunity",
            "dataType": "double",
            "sourceColumn": "opportunity",
            "summarizeBy": "sum"
          }
        ],
        "partitions": [
          {
            "name": "by_service",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "Csv.Document(File.Contents(ExtractFolder & \"\\by_service.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv])"
            }
          }
        ],
        "measures": [
          {
            "name": "Denied amount (by_service)",
            "expression": "SUM ( 'by_service'[denied_amt] )",
            "formatString": "#,0.00",
            "description": "Denied amount for the 'Denial rate by service line' visual."
          },
          {
            "name": "Denial rate % (by_service)",
            "expression": "AVERAGE ( 'by_service'[denial_pct] )",
            "formatString": "#,0.00",
            "description": "Denial rate % for the 'Denial rate by service line' visual."
          }
        ]
      },
      {
        "name": "controls",
        "columns": [
          {
            "name": "control",
            "dataType": "string",
            "sourceColumn": "control",
            "summarizeBy": "none"
          },
          {
            "name": "gaps",
            "dataType": "int64",
            "sourceColumn": "gaps",
            "summarizeBy": "sum"
          },
          {
            "name": "denial_pct_when_failed",
            "dataType": "double",
            "sourceColumn": "denial_pct_when_failed",
            "summarizeBy": "sum"
          }
        ],
        "partitions": [
          {
            "name": "controls",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "Csv.Document(File.Contents(ExtractFolder & \"\\controls.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv])"
            }
          }
        ],
        "measures": [
          {
            "name": "Claims where control failed (controls)",
            "expression": "SUM ( 'controls'[gaps] )",
            "formatString": "#,0.00",
            "description": "Claims where control failed for the 'Which control failed, and what happened when it did' visual."
          },
          {
            "name": "Denial rate when failed % (controls)",
            "expression": "AVERAGE ( 'controls'[denial_pct_when_failed] )",
            "formatString": "#,0.00",
            "description": "Denial rate when failed % for the 'Which control failed, and what happened when it did' visual."
          }
        ]
      },
      {

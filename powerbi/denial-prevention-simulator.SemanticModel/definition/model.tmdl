model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["headline", "queue_head", "by_reason", "by_category", "by_payer", "by_service", "controls", "risk_band", "submit_lag", "monthly", "resub", "work_queue", "rules", "queue", "queue_owner", "exceptions"]

ref table headline
ref table queue_head
ref table by_reason
ref table by_category
ref table by_payer
ref table by_service
ref table controls
ref table risk_band
ref table submit_lag
ref table monthly
ref table resub
ref table work_queue
ref table rules
ref table queue
ref table queue_owner
ref table exceptions

ref expression ExtractFolder